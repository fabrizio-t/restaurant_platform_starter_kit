# MENUOF Starter Project - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# REQUIRED CONFIGURATION
# ===========================================

# Your store's unique slug (found in your MENUOF dashboard)
# This identifies which restaurant's menu to display
NEXT_PUBLIC_STORE_SLUG=your-store-slug

# MENUOF API Base URL
# Default: http://localhost:3001/ (for local development)
# Production: https://api.ordina.online/
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/

# MENUOF Platform URL (where users are redirected for checkout)
# This should be your store's subdomain on the MENUOF platform
# Example: https://your-store.ordina.online
NEXT_PUBLIC_MENUOF_PLATFORM_URL=http://localhost:3000

# Image storage bucket URL (Cloudflare R2)
# This is where product/store images are hosted
NEXT_PUBLIC_BUCKET_URL=https://3d1da5272d71dd829c0b3d13a993b10a.eu.r2.cloudflarestorage.com

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Default language for the menu
# Supported: en, es, fr, it, de, pt, ru, zh
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
